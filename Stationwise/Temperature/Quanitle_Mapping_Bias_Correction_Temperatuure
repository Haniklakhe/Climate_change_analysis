ive\n","/content/drive/MyDrive/Hydrology_Applications/Climate_change_analysis\n"]}]},{"cell_type":"code","execution_count":2,"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":327,"referenced_widgets":["0587b30d1125447b81720bbd4fda07fc","588d8470335e46f09d05d86b70425605","3e74ad32acc149028b8e6b92857df381","c2a1fd5699da45feaf784a3ab4f3f8c5","d47094729cbd4ae59bfbbe128f9b4896","35cd0899910f45e6bd79724f9d710cbd","380a68aac0124750adc5638a9a56d004","974de739ad5a440489897d7fdab9da94","2a80656d4d684d70ac9cf62f7344805f","4492697474f74d8688d893c36c8afcd6","efd926a4407042d58f310a8f636bbf1e"]},"id":"zvBbG8RdvM95","executionInfo":{"status":"ok","timestamp":1782579619039,"user_tz":-420,"elapsed":6417,"user":{"displayName":"Hanik Lakhe","userId":"10111252980706465882"}},"outputId":"9946b2c6-18a8-44fb-8bbc-de671a83e0c2"},"outputs":[{"output_type":"stream","name":"stdout","text":["======================================================================\n","Reading Observed Maximum Temperature ...\n","======================================================================\n","Observed stations : 16\n","Observed days     : 10957\n","\n","Models found (0):\n"]},{"output_type":"display_data","data":{"text/plain":["Models: 0it [00:00, ?it/s]"],"application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"0587b30d1125447b81720bbd4fda07fc"}},"metadata":{}},{"output_type":"stream","name":"stdout","text":["\n","======================================================================\n","EQM TASMAX BIAS CORRECTION — COMPLETE\n","======================================================================\n","Empty DataFrame\n","Columns: []\n","Index: []\n","\n","Summary saved to : Stationwise/Temperature/Tasmax/BiasCorrected_QM_Tasmax/qm_tasmax_summary.csv\n"]}],"source":["# ==========================================================\n","# Empirical Quantile Mapping (EQM) Bias Correction\n","# TEMPERATURE (TASMAX)\n","# For Multiple CMIP6 Models and Multiple Scenarios\n","#\n","# Equations applied (per Themebl et al., 2012; Gudmundsson, 2014):\n","#   T_his(d)* = F_obs,m^{-1} [ F_his,m ( T_his,m ) ]   -- Eq. 1\n","#   T_sim(d)* = F_obs,m^{-1} [ F_sim,m ( T_sim,m ) ]   -- Eq. 2\n","# ==========================================================\n","\n","import os\n","import gc\n","import numpy as np\n","import pandas as pd\n","from tqdm.auto import tqdm\n","\n","# ==========================================================\n","# USER SETTINGS\n","# ==========================================================\n","\n","INPUT_ROOT  = \"Stationwise/Temperature/Tasmax/Raw_GCM_Tasmax\"\n","OUTPUT_ROOT = \"Stationwise/Temperature/Tasmax/BiasCorrected_QM_Tasmax\"\n","\n","OBS_FILE  = \"Stationwise/Karnali_1986_2015.xlsx\"\n","OBS_SHEET = \"TMax\"\n","\n","SCENARIOS = [\"historical\", \"ssp245\", \"ssp585\"]\n","\n","CAL_START = \"1986-01-01\"\n","CAL_END   = \"2014-12-31\"\n","\n","N_QUANTILES = 99\n","\n","# ==========================================================\n","# HELPER – BUILD MONTHLY EMPIRICAL CDFs\n","# ==========================================================\n","\n","def build_monthly_cdfs(series: pd.Series, n_quantiles: int = 99) -> dict:\n","    \"\"\"\n","    Build one empirical CDF (quantile table) per calendar month.\n","\n","    Parameters\n","    ----------\n","    series      : daily time series with a DatetimeIndex\n","    n_quantiles : number of percentile points\n","\n","    Returns\n","    -------\n","    dict { month (1-12): {\"probs\": array, \"values\": array} }\n","    \"\"\"\n","    probs = np.linspace(0, 1, n_quantiles + 2)\n","    cdfs  = {}\n","    for m in range(1, 13):\n","        vals = series[series.index.month == m].dropna().values\n","        if len(vals) == 0:\n","            cdfs[m] = {\"probs\": probs, \"values\": np.full_like(probs, np.nan)}\n","        else:\n","            cdfs[m] = {\"probs\": probs, \"values\": np.quantile(vals, probs)}\n","    return cdfs\n","\n","\n","# ==========================================================\n","# HELPER – APPLY EQM (NO CLIPPING for temperature)\n","# ==========================================================\n","\n","def apply_eqm(raw_series: pd.Series,\n","              cdf_raw: dict,\n","              cdf_obs: dict) -> pd.Series:\n","    \"\"\"\n","    Apply Empirical Quantile Mapping month by month for temperature.\n","\n","    For each daily value x:\n","      1. Find its quantile rank p in the raw monthly CDF  → F_raw,m(x)\n","      2. Map p through the inverse observed monthly CDF   → F_obs,m^{-1}(p)\n","\n","    Note: No clipping applied — temperature can be negative.\n","\n","    Parameters\n","    ----------\n","    raw_series : daily GCM temperature values (DatetimeIndex)\n","    cdf_raw    : monthly CDFs of the raw GCM series\n","    cdf_obs    : monthly CDFs of the observed series\n","\n","    Returns\n","    -------\n","    pd.Series : bias-corrected daily temperature, same index as raw_series\n","    \"\"\"\n","    corrected = raw_series.copy().astype(float)\n","\n","    for m in range(1, 13):\n","        mask = raw_series.index.month == m\n","        if not mask.any():\n","            continue\n","\n","        raw_vals = raw_series.loc[mask].values\n","        r_probs  = cdf_raw[m][\"probs\"]\n","        r_vals   = cdf_raw[m][\"values\"]\n","        o_probs  = cdf_obs[m][\"probs\"]\n","        o_vals   = cdf_obs[m][\"values\"]\n","\n","        if np.all(np.isnan(r_vals)) or np.all(np.isnan(o_vals)):\n","            continue\n","\n","        # Step 1 – forward CDF: get quantile rank of each raw value\n","        p_ranks = np.interp(raw_vals, r_vals, r_probs)\n","\n","        # Step 2 – inverse CDF: map rank through observed distribution\n","        corrected.loc[mask] = np.interp(p_ranks, o_probs, o_vals)\n","\n","    return corrected\n","\n","\n","# ==========================================================\n","# READ OBSERVED TEMPERATURE (TMax)\n","# ==========================================================\n","\n","print(\"=\" * 70)\n","print(\"Reading Observed Maximum Temperature ...\")\n","print(\"=\" * 70)\n","\n","df_obs = pd.read_excel(OBS_FILE, sheet_name=OBS_SHEET)\n","\n","for col in [\"year\", \"month\", \"days\"]:\n","    if col in df_obs.columns:\n","        df_obs.drop(columns=col, inplace=True)\n","\n","df_obs[\"Date\"] = pd.to_datetime(df_obs[\"Date\"])\n","df_obs.set_index(\"Date\", inplace=True)\n","df_obs.index = df_obs.index.normalize()\n","df_obs.columns = df_obs.columns.astype(str)\n","\n","print(f\"Observed stations : {len(df_obs.columns)}\")\n","print(f\"Observed days     : {len(df_obs)}\")\n","\n","# ==========================================================\n","# FIND AVAILABLE MODELS\n","# ==========================================================\n","\n","models = sorted([\n","    d for d in os.listdir(INPUT_ROOT)\n","    if os.path.isdir(os.path.join(INPUT_ROOT, d))\n","])\n","\n","print(f\"\\nModels found ({len(models)}):\")\n","for m in models:\n","    print(\"  \", m)\n","\n","# ==========================================================\n","# MAIN LOOP\n","# ==========================================================\n","\n","summary = []\n","\n","for model in tqdm(models, desc=\"Models\", colour=\"green\"):\n","    print(f\"\\n{'='*70}\")\n","    print(f\"MODEL : {model}\")\n","    print(f\"{'='*70}\")\n","\n","    # ------------------------------------------------------\n","    # Load Historical GCM Tasmax\n","    # ------------------------------------------------------\n","    hist_file = os.path.join(\n","        INPUT_ROOT, model, \"historical\",\n","        f\"{model}_historical_karnali_tasmax.csv\"  # tasmax variable\n","    )\n","\n","    if not os.path.exists(hist_file):\n","        print(\"  Historical tasmax file missing – skipping model.\")\n","        continue\n","\n","    df_hist = pd.read_csv(hist_file)\n","    df_hist[\"Date\"] = pd.to_datetime(df_hist[\"Date\"])\n","    df_hist.set_index(\"Date\", inplace=True)\n","    df_hist.index = df_hist.index.normalize()\n","    df_hist.columns = df_hist.columns.astype(str)\n","\n","    # ------------------------------------------------------\n","    # Common dates & calibration slice\n","    # ------------------------------------------------------\n","    common_dates = df_obs.index.intersection(df_hist.index)\n","    obs_common   = df_obs.loc[common_dates]\n","    hist_common  = df_hist.loc[common_dates]\n","\n","    print(f\"  Common dates     : {len(common_dates)}\")\n","\n","    obs_cal  = obs_common.loc[CAL_START:CAL_END]\n","    hist_cal = hist_common.loc[CAL_START:CAL_END]\n","\n","    print(f\"  Calibration days : {len(obs_cal)}\")\n","\n","    # ------------------------------------------------------\n","    # Automatic station matching  (obs_id → gcm_col)\n","    # ------------------------------------------------------\n","    station_map = {}\n","    for obs_st in df_obs.columns:\n","        for gcm_col in df_hist.columns:\n","            if gcm_col.startswith(obs_st):\n","                station_map[obs_st] = gcm_col\n","                break\n","\n","    print(f\"  Matched stations : {len(station_map)}\")\n","    if not station_map:\n","        print(\"  No matched stations – skipping model.\")\n","        continue\n","\n","    # ------------------------------------------------------\n","    # Build calibration-period CDFs\n","    #   obs_cdfs  : observed  → F_obs,m^{-1} in all equations\n","    #   hist_cdfs : historical GCM → F_his,m  in Eq. 1\n","    # ------------------------------------------------------\n","    obs_cdfs  = {}\n","    hist_cdfs = {}\n","\n","    for obs_st in tqdm(station_map, desc=\"Building CDFs\", leave=False, colour=\"yellow\"):\n","        gcm_col = station_map[obs_st]\n","        obs_cdfs[obs_st]  = build_monthly_cdfs(obs_cal[obs_st],   N_QUANTILES)\n","        hist_cdfs[obs_st] = build_monthly_cdfs(hist_cal[gcm_col], N_QUANTILES)\n","\n","    print(\"  Monthly CDFs built.\")\n","\n"," 