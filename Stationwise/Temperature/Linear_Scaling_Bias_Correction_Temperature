min\": 2.1,\n        \"max\": 29.0,\n        \"num_unique_values\": 208,\n        \"samples\": [\n          10.8,\n          17.1,\n          14.5\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"}},"metadata":{},"execution_count":15}],"source":["# ==========================================================\n","# Monthly Linear Scaling Bias Correction\n","# For Multiple CMIP6 Models and Multiple Scenarios\n","#\n","# Author: Hanik Lakhe (Modified)\n","# ==========================================================\n","\n","import os\n","import gc\n","import numpy as np\n","import pandas as pd\n","from tqdm.auto import tqdm\n","\n","# ==========================================================\n","# USER SETTINGS\n","# ==========================================================\n","\n","INPUT_ROOT = \"Stationwise/Temperature/Tasmax/Raw_GCM_Tasmax\"\n","OUTPUT_ROOT = \"Stationwise/Temperature/Tasmax/BiasCorrected_LS_Tasmax\"\n","\n","OBS_FILE = \"Stationwise/Karnali_1986_2015.xlsx\"\n","OBS_SHEET = \"TMax\"\n","\n","SCENARIOS = [\n","    \"historical\",\n","    \"ssp245\",\n","    \"ssp585\"\n","]\n","\n","CAL_START = \"1986-01-01\"\n","CAL_END = \"2014-12-31\"\n","\n","# ==========================================================\n","# READ OBSERVED DATA\n","# ==========================================================\n","\n","print(\"=\"*70)\n","print(\"Reading Observed Dataset...\")\n","print(\"=\"*70)\n","\n","df_obs = pd.read_excel(\n","    OBS_FILE,\n","    sheet_name=OBS_SHEET\n",")\n","\n","# Remove unnecessary columns if present\n","for col in [\"year\", \"month\", \"days\"]:\n","    if col in df_obs.columns:\n","        df_obs.drop(columns=col, inplace=True)\n","\n","# Date\n","df_obs[\"Date\"] = pd.to_datetime(df_obs[\"Date\"])\n","df_obs.set_index(\"Date\", inplace=True)\n","df_obs.index = df_obs.index.normalize()\n","\n","# Ensure string columns\n","df_obs.columns = df_obs.columns.astype(str)\n","\n","print(f\"Observed stations : {len(df_obs.columns)}\")\n","print(f\"Observed days     : {len(df_obs)}\")\n","\n","df_obs.head(5)"]},{"cell_type":"code","source":["# ==========================================================\n","# FIND AVAILABLE MODELS\n","# ==========================================================\n","\n","models = sorted([\n","    d for d in os.listdir(INPUT_ROOT)\n","    if os.path.isdir(os.path.join(INPUT_ROOT, d))\n","])\n","\n","print(\"\\nModels Found\")\n","\n","for m in models:\n","    print(\"  \", m)\n","\n","print(\"\\nTotal Models :\", len(models))"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"RownnprajZYI","executionInfo":{"status":"ok","timestamp":1782579693199,"user_tz":-420,"elapsed":14,"user":{"displayName":"Hanik Lakhe","userId":"10111252980706465882"}},"outputId":"bbb3516d-af5f-4257-e649-f0954a0847df"},"execution_count":16,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","Models Found\n","\n","Total Models : 0\n"]}]},{"cell_type":"code","source":["summary = []\n","# ==========================================================\n","# LOOP OVER MODELS\n","# ==========================================================\n","for model in tqdm(models,\n","                  desc=\"Models\",\n","                  colour=\"green\"):\n","    print(f\"MODEL : {model}\")\n","    hist_file = os.path.join(\n","        INPUT_ROOT,\n","        model,\n","        \"historical\",\n","        f\"{model}_historical_karnali_tasmax.csv\"  # tas = temperature\n","    )\n","    if not os.path.exists(hist_file):\n","        print(\"Historical file missing.\")\n","        continue\n","\n","    # ------------------------------------------------------\n","    # Read Historical GCM\n","    # ------------------------------------------------------\n","\n","    df_hist = pd.read_csv(hist_file)\n","    df_hist[\"Date\"] = pd.to_datetime(df_hist[\"Date\"])\n","    df_hist.set_index(\"Date\", inplace=True)\n","    df_hist.index = df_hist.index.normalize()\n","    df_hist.columns = df_hist.columns.astype(str)\n","\n","    # ------------------------------------------------------\n","    # Common Dates\n","    # ------------------------------------------------------\n","\n","    common_dates = df_obs.index.intersection(df_hist.index)\n","    obs = df_obs.loc[common_dates].copy()\n","    hist = df_hist.loc[common_dates].copy()\n","\n","    print(\"Common Dates :\", len(common_dates))\n","\n","    # ------------------------------------------------------\n","    # Calibration Period\n","    # ------------------------------------------------------\n","\n","    obs_cal = obs.loc[CAL_START:CAL_END].copy()\n","    hist_cal = hist.loc[CAL_START:CAL_END].copy()\n","\n","    print(\"Calibration Days :\", len(obs_cal))\n","\n","    # ------------------------------------------------------\n","    # Automatic Station Matching\n","    # ------------------------------------------------------\n","\n","    station_map = {}\n","    for obs_station in obs.columns:\n","        for gcm_station in hist.columns:\n","            if gcm_station.startswith(obs_station):\n","                station_map[obs_station] = gcm_station\n","                break\n","\n","    print(\"Matched Stations :\", len(station_map))\n","\n","    # ------------------------------------------------------\n","    # Add Year and Month\n","    # ------------------------------------------------------\n","\n","    obs_cal[\"year\"] = obs_cal.index.year\n","    obs_cal[\"month\"] = obs_cal.index.month\n","\n","    hist_cal[\"year\"] = hist_cal.index.year\n","    hist_cal[\"month\"] = hist_cal.index.month\n","\n","    # ------------------------------------------------------\n","    # Compute Monthly Additive Correction Offsets\n","    # (offset = obs_mean - gcm_mean, applied additively)\n","    # ------------------------------------------------------\n","\n","    correction_offsets = {}  # renamed from correction_factors\n","\n","    for st in tqdm(\n","            station_map.keys(),\n","            desc=\"Computing Offsets\",\n","            leave=False,\n","            colour=\"yellow\"):\n","\n","        gcm_col = station_map[st]\n","\n","        obs_monthly = (\n","            obs_cal\n","            .groupby([\"year\", \"month\"])[st]\n","            .mean()  # mean for temperature (not sum)\n","            .reset_index()\n","        )\n","\n","        gcm_monthly = (\n","            hist_cal\n","            .groupby([\"year\", \"month\"])[gcm_col]\n","            .mean()  # mean for temperature (not sum)\n","            .reset_index()\n","        )\n","\n","        obs_clim = (\n","            obs_monthly\n","            .groupby(\"month\")[st]\n","            .mean()\n","        )\n","\n","        gcm_clim = (\n","            gcm_monthly\n","            .groupby(\"month\")[gcm_col]\n","            .mean()\n","        )\n","\n","        offset = obs_clim - gcm_clim  # additive offset (not ratio)\n","\n","        correction_offsets[st] = offset\n","\n","    print(\"Monthly correction offsets computed.\")\n","\n","    # ======================================================\n","    # APPLY CORRECTION TO ALL SCENARIOS\n","    # ======================================================\n","\n","    for scenario in tqdm(\n","            SCENARIOS,\n","            desc=f\"{model}\",\n","            leave=False,\n","            colour=\"blue\"):\n","\n","        input_file = os.path.join(\n","            INPUT_ROOT,\n","            model,\n","            scenario,\n","            f\"{model}_{scenario}_karnali_tas.csv\"  # tas = temperature\n","        )\n","\n","        if not os.path.exists(input_file):\n","            print(f\"\\n{scenario} file not found.\")\n","            continue\n","\n","        print(f\"\\nProcessing {scenario}\")\n","\n","        try:\n","\n","            # -------------------------------------------------\n","            # Read Scenario\n","            # -------------------------------------------------\n","\n","            df = pd.read_csv(input_file)\n","            df[\"Date\"] = pd.to_datetime(df[\"Date\"])\n","            df.set_index(\"Date\", inplace=True)\n","            df.index = df.index.normalize()\n","            df.columns = df.columns.astype(str)\n","\n","            # -------------------------------------------------\n","            # Add Month Column\n","            # -------------------------------------------------\n","\n","            df[\"month\"] = df.index.month\n","\n","            # -------------------------------------------------\n","            # Create Output Copy\n","            # -------------------------------------------------\n","\n","            corrected = df.copy()\n","\n","            # -------------------------------------------------\n","            # Apply Monthly Additive Bias Correction\n","            # -------------------------------------------------\n","\n","            for st in tqdm(\n","                    station_map.keys(),\n","                    desc=f\"{scenario}\",\n","                    leave=False,\n","                    colour=\"cyan\"):\n","\n","                gcm_col = station_map[st]\n","\n","                if gcm_col not in corrected.columns:\n","                    continue\n","\n","                offset = correction_offsets[st]\n","\n","                for month in range(1, 13):\n","\n","                    if month not in offset.index:\n","                        continue\n","\n","                    mask = corrected[\"month\"] == month\n","\n","                    corrected.loc[\n","                        mask,\n","                        gcm_col\n","                    ] = (\n","                        corrected.loc[\n","                            mask,\n","                            gcm_col\n","                        ] + offset[month]  # additive correction\n","                    )\n","\n","            # -------------------------------------------------\n","            # Remove Helper Column\n","            # -------------------------------------------------\n","\n","            corrected.drop(columns=\"month\", inplace=True)\n","\n","            # -------------------------------------------------\n","            # Create Output Folder\n","            # -------------------------------------------------\n","\n","            out_dir = os.path.join(\n","                OUTPUT_ROOT,\n","                model,\n","                scenario\n","            )\n","\n","            os.makedirs(out_dir, exist_ok=True)\n","\n","            output_file = os.path.join(\n","                out_dir,\n","                f\"{model}_{scenario}_tas_bias_corrected.csv\"  # tas in filename\n","            )\n","\n","            corrected.to_csv(output_file)\n","\n","            print(f\"Saved : {output_file}\")\n","\n","            summary.append({\n","                \"Model\": model,\n","                \"Scenario\": scenario,\n","                \"Stations\": len(station_map),\n","                \"Days\": len(corrected),\n","                \"Output\": output_file,\n","                \"Status\": \"Success\"\n","            })\n","\n","        except Exception as e:\n","\n","            print(f\"Error while processing {scenario}\")\n","            print(e)\n","\n","            summary.append({\n","                \"Model\": model,\n","                \"Scenario\": scenario,\n","                \"Stations\": 0,\n","                \"Days\": 0,\n","                \"Output\": \"\",\n","                \"Status\": \"Failed\"\n","            })\n","\n","        finally:\n","            del df\n","            if \"corrected\" in locals():\n","                del corrected\n","            gc.collect()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":49,"referenced_widgets":["eef82e1ed56145a7a0511800d509334f","b1662bf58b5f4018897a41ec7b60da1b","607f0828ffde4345905539146e973f09","2e3932e4acc8468e9d458cd24f2cb349","b3981479c42f41d1869188c4d0ab7ca1","e