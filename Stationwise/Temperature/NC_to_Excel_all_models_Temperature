fully installed rioxarray-0.22.0 xarray-2026.4.0\n"]}]},{"cell_type":"code","source":["from google.colab import drive\n","drive.mount('/content/drive')\n","\n","%cd /content/drive/MyDrive/Hydrology_Applications/Climate_change_analysis"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"6bln_cMWgHOn","executionInfo":{"status":"ok","timestamp":1782578153696,"user_tz":-420,"elapsed":19447,"user":{"displayName":"Hanik Lakhe","userId":"10111252980706465882"}},"outputId":"2b91748e-0c69-4370-c84a-e614e2398db0"},"execution_count":2,"outputs":[{"output_type":"stream","name":"stdout","text":["Mounted at /content/drive\n","/content/drive/MyDrive/Hydrology_Applications/Climate_change_analysis\n"]}]},{"cell_type":"code","source":["# =============================================================\n","# CMIP6 Station-wise Extraction for Multiple Models & Scenarios\n","# =============================================================\n","\n","import os\n","import xarray as xr\n","import rioxarray\n","import geopandas as gpd\n","import pandas as pd\n","import numpy as np\n","from tqdm.auto import tqdm\n","\n","# =============================================================\n","# USER INPUTS\n","# =============================================================\n","\n","# Root directory containing all CMIP6 models\n","BASE_PATH = \"/content/drive/MyDrive/NEX_GDDP_CMIP6\"\n","\n","# Variable name\n","VARIABLE = \"tasmax\"\n","\n","# Scenarios to process\n","SCENARIOS = [\n","    \"historical\",\n","    \"ssp245\",\n","    \"ssp585\"\n","]\n","\n","# Basin shapefile\n","SHP_PATH = \"Basin_shp/Karnali_basin.shp\"\n","\n","# Station file\n","STATION_FILE = \"Stationwise/Karnali_1986_2015.xlsx\"\n","\n","# Output directory\n","OUTPUT_ROOT = \"Stationwise/Temperature/Maximum_Temperature/Raw_GCM_Maximum_Temperature\"\n","\n","# =============================================================\n","# READ BASIN\n","# =============================================================\n","\n","print(\"Reading basin...\")\n","\n","basin = gpd.read_file(SHP_PATH)\n","\n","if basin.crs != \"EPSG:4326\":\n","    basin = basin.to_crs(\"EPSG:4326\")\n","\n","# =============================================================\n","# READ STATIONS\n","# =============================================================\n","\n","print(\"Reading stations...\")\n","\n","stations = pd.read_excel(\n","    STATION_FILE,\n","    sheet_name=\"Sheet1\"\n",")\n","\n","station_ids = stations[\"Index No.\"].astype(str).values\n","\n","station_lats = xr.DataArray(\n","    stations[\"Lat\"].values,\n","    dims=\"station\",\n","    coords={\"station\": station_ids}\n",")\n","\n","station_lons = xr.DataArray(\n","    stations[\"Lon\"].values,\n","    dims=\"station\",\n","    coords={\"station\": station_ids}\n",")\n","\n","# =============================================================\n","# FIND AVAILABLE MODELS\n","# =============================================================\n","\n","models = sorted([\n","    d for d in os.listdir(BASE_PATH)\n","    if os.path.isdir(os.path.join(BASE_PATH, d))\n","])\n","\n","print(models)\n","\n","models = ['ACCESS-CM2', 'ACCESS-ESM1-5']"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"CZ1MZahN7f7N","executionInfo":{"status":"ok","timestamp":1782578164273,"user_tz":-420,"elapsed":10555,"user":{"displayName":"Hanik Lakhe","userId":"10111252980706465882"}},"outputId":"1728f664-d1cd-48d0-ba89-7ce8c78f1b13"},"execution_count":3,"outputs":[{"output_type":"stream","name":"stdout","text":["Reading basin...\n","Reading stations...\n","['ACCESS-CM2', 'ACCESS-ESM1-5', 'BCC-CSM2-MR', 'CanESM5', 'EC-Earth3', 'EC-Earth3-Veg', 'GFDL-ESM4', 'INM-CM4-8', 'INM-CM5-0', 'IPSL-CM6A-LR', 'MIROC6', 'MPI-ESM1-2-HR', 'MPI-ESM1-2-LR', 'MRI-ESM2-0', 'NorESM2-LM', 'NorESM2-MM', 'clipped_gcm']\n"]}]},{"cell_type":"code","source":["# =============================================================\n","# MAIN LOOP\n","# =============================================================\n","\n","for GCM in models:\n","\n","    print(\"\\n\")\n","    print(\"=\" * 70)\n","    print(\"Processing Model :\", GCM)\n","    print(\"=\" * 70)\n","\n","    for scenario in SCENARIOS:\n","\n","        print(f\"\\nScenario : {scenario}\")\n","\n","        data_path = os.path.join(\n","            BASE_PATH,\n","            GCM,\n","            scenario,\n","            VARIABLE\n","        )\n","\n","        # ---------------------------------------------------------\n","        # Check folder\n","        # ---------------------------------------------------------\n","\n","        if not os.path.exists(data_path):\n","            print(\"Folder not found.\")\n","            continue\n","\n","        files = sorted([\n","            os.path.join(data_path, f)\n","            for f in os.listdir(data_path)\n","            if f.endswith(\".nc\")\n","        ])\n","\n","        if len(files) == 0:\n","            print(\"No NetCDF files.\")\n","            continue\n","\n","        print(f\"NetCDF files : {len(files)}\")\n","\n","        try:\n","\n","            # =====================================================\n","            # READ DATA\n","            # =====================================================\n","\n","            ds = xr.open_mfdataset(\n","                files,\n","                combine=\"by_coords\",\n","                parallel=True\n","            )\n","\n","            ds = ds.rio.write_crs(\"EPSG:4326\")\n","\n","            # =====================================================\n","            # CLIP BASIN\n","            # =====================================================\n","\n","            ds_clip = ds.rio.clip(\n","                basin.geometry,\n","                basin.crs,\n","                drop=True\n","            )\n","\n","            temp = ds_clip[VARIABLE]\n","\n","            # =====================================================\n","            # EXTRACT STATIONS\n","            # =====================================================\n","\n","            station_temp = temp.sel(\n","                lat=station_lats,\n","                lon=station_lons,\n","                method=\"nearest\"\n","            )\n","\n","            # =====================================================\n","            # No unit conversion needed (tasmax is in Kelvin)\n","            # Optionally convert K → °C: station_temp = station_temp - 273.15\n","            # =====================================================\n","\n","            # =====================================================\n","            # CREATE DATAFRAME\n","            # =====================================================\n","\n","            df = pd.DataFrame(\n","                station_temp.values,                  # FIX: was station_pr\n","                index=station_temp.time.values,       # FIX: was station_pr\n","                columns=station_ids\n","            )\n","\n","            df.index.name = \"Date\"\n","\n","            df.reset_index(inplace=True)\n","\n","            df[\"Date\"] = pd.to_datetime(df[\"Date\"]).dt.normalize()\n","\n","            # =====================================================\n","            # Rename columns with selected grid coordinates\n","            # =====================================================\n","\n","            new_columns = {\"Date\": \"Date\"}\n","\n","            for i, sid in enumerate(station_ids):\n","\n","                grid_lat = float(station_temp.lat.values[i])  # FIX: was station_pr\n","                grid_lon = float(station_temp.lon.values[i])  # FIX: was station_pr\n","\n","                new_columns[sid] = (\n","                    f\"{sid} ({grid_lat:.3f}, {grid_lon:.3f})\"\n","                )\n","\n","            df.rename(columns=new_columns, inplace=True)\n","\n","            # =====================================================\n","            # SAVE\n","            # =====================================================\n","\n","            out_dir = os.path.join(\n","                OUTPUT_ROOT,\n","                GCM,\n","                scenario\n","            )\n","\n","            os.makedirs(out_dir, exist_ok=True)\n","\n","            out_csv = os.path.join(\n","                out_dir,\n","                f\"{GCM}_{scenario}_karnali_{VARIABLE}.csv\"  # FIX: was lowercase variable\n","            )\n","\n","            df.to_csv(out_csv, index=False)\n","\n","            print(\"Saved :\", out_csv)\n","            print(\"Stations :\", len(station_ids))\n","            print(\"Days :\", len(df))\n","\n","            ds.close()\n","\n","        except Exception as e:\n","\n","            print(f\"Failed : {GCM} {scenario}\")\n","            print(e)\n","\n","# =============================================================\n","# FINISHED\n","# =============================================================\n","\n","print(\"\\n\")\n","print(\"=\" * 70)\n","print(\"ALL PROCESSING COMPLETED\")\n","print(\"=\" * 70)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"wpyVMKxt7oau","outputId":"d80f3429-63b1-4928-9f66-e3eb9bdb5757"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","\n","======================================================================\n","Processing Model : ACCESS-CM2\n","======================================================================\n","\n","Scenario : historical\n","NetCDF files : 30\n"]}]}]}